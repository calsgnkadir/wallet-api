# Bu dosyayı ".env" olarak kopyalayın ve kendi anahtarınızı üretin.
# ".env" git'e girmez; gerçek anahtar hiçbir zaman repoda tutulmaz.
#
# Rastgele anahtar üretmek için:
#   PowerShell : [Convert]::ToBase64String((1..64 | ForEach-Object { Get-Random -Max 256 }))
#   Linux/macOS: openssl rand -base64 64

JWT_KEY=buraya-en-az-32-baytlik-rastgele-bir-deger-yazin

# İsteğe bağlı: denetim kaydını okuyabilecek yönetici hesabı.
# Boş bırakılırsa yönetici oluşturulmaz.
ADMIN_EMAIL=
ADMIN_PASSWORD=
